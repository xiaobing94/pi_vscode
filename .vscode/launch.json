{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Pi VS Code Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    }
  ],
  "tasks": [
    {
      "type": "npm",
      "script": "build",
      "problemMatcher": []
    }
  ]
}

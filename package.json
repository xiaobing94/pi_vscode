{
  "name": "pi-shadow-agent",
  "displayName": "Pi Shadow Agent",
  "description": "%description%",
  "version": "0.3.0",
  "publisher": "xiaobing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaobing94/pi_vscode.git"
  },
  "bugs": {
    "url": "https://github.com/xiaobing94/pi_vscode/issues"
  },
  "homepage": "https://github.com/xiaobing94/pi_vscode#readme",
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22.19.0"
  },
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "pi",
    "pi coding agent",
    "ai coding agent",
    "ai agent",
    "autonomous agent",
    "vscode",
    "vs code",
    "shadow git",
    "ai diff",
    "code review",
    "claude code",
    "cursor",
    "copilot alternative",
    "ai pair programmer",
    "chat participant",
    "side panel",
    "terminal agent",
    "mcp",
    "llm",
    "openai",
    "anthropic"
  ],
  "icon": "media/icon-256.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:pi.chat",
    "onView:pi.chatSecondary",
    "onView:pi.sessions",
    "onView:pi.changes",
    "onView:pi.agents",
    "onChatParticipant:pi-vscode.pi"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "%untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/integration/*.mjs",
    "test:integration": "npm run test",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies --baseContentUrl . --baseImagesUrl .",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('media/chat/main.js',{force:true})\""
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pi-vscode",
          "title": "Pi (VS Code)",
          "icon": "media/pi.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "pi-vscode-secondary",
          "title": "Pi",
          "icon": "media/pi.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "pi.sessions",
          "name": "%views.explorer.pi.sessions.name%",
          "contextualTitle": "%views.explorer.pi.sessions.contextualTitle%",
          "visibility": "visible"
        },
        {
          "id": "pi.changes",
          "name": "%views.explorer.pi.changes.name%",
          "contextualTitle": "%views.explorer.pi.changes.contextualTitle%",
          "visibility": "visible"
        },
        {
          "id": "pi.agents",
          "name": "%views.explorer.pi.agents.name%",
          "contextualTitle": "%views.explorer.pi.agents.contextualTitle%",
          "visibility": "collapsed"
        }
      ],
      "pi-vscode": [
        {
          "id": "pi.chat",
          "name": "%views.pi-vscode.pi.chat.name%",
          "type": "webview",
          "contextualTitle": "Pi",
          "visibility": "visible"
        }
      ],
      "pi-vscode-secondary": [
        {
          "id": "pi.chatSecondary",
          "name": "%views.pi-vscode-secondary.pi.chatSecondary.name%",
          "type": "webview",
          "contextualTitle": "Pi",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pi.sessions",
        "contents": "%viewsWelcome.pi.sessions.contents%"
      },
      {
        "view": "pi.changes",
        "contents": "%viewsWelcome.pi.changes.contents%"
      },
      {
        "view": "pi.agents",
        "contents": "%viewsWelcome.pi.agents.contents%"
      }
    ],
    "commands": [
      {
        "command": "pi.chat.focus",
        "title": "%commands.pi.chat.focus.title%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "pi.chat.focusSecondary",
        "title": "%commands.pi.chat.focusSecondary.title%",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "pi.chat.askInNativeChat",
        "title": "%commands.pi.chat.askInNativeChat.title%",
        "icon": "$(mention)"
      },
      {
        "command": "pi.newSession",
        "title": "%commands.pi.newSession.title%",
        "icon": "$(add)"
      },
      {
        "command": "pi.resumeSession",
        "title": "%commands.pi.resumeSession.title%",
        "icon": "$(versions)"
      },
      {
        "command": "pi.newParallelSession",
        "title": "%commands.pi.newParallelSession.title%",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "pi.openSessionInNewTab",
        "title": "%commands.pi.openSessionInNewTab.title%"
      },
      {
        "command": "pi.closeParallelSession",
        "title": "%commands.pi.closeParallelSession.title%"
      },
      {
        "command": "pi.switchSession",
        "title": "%commands.pi.switchSession.title%"
      },
      {
        "command": "pi.renameSession",
        "title": "%commands.pi.renameSession.title%"
      },
      {
        "command": "pi.forkSession",
        "title": "%commands.pi.forkSession.title%"
      },
      {
        "command": "pi.cloneSession",
        "title": "%commands.pi.cloneSession.title%"
      },
      {
        "command": "pi.exportHtml",
        "title": "%commands.pi.exportHtml.title%"
      },
      {
        "command": "pi.sharePreview",
        "title": "%commands.pi.sharePreview.title%"
      },
      {
        "command": "pi.openTui",
        "title": "%commands.pi.openTui.title%",
        "icon": "$(terminal)"
      },
      {
        "command": "pi.openChangesOverview",
        "title": "%commands.pi.openChangesOverview.title%",
        "icon": "$(list-unordered)"
      },
      {
        "command": "pi.openChangeDiff",
        "title": "%commands.pi.openChangeDiff.title%",
        "icon": "$(diff)"
      },
      {
        "command": "pi.openTurnDiff",
        "title": "%commands.pi.openTurnDiff.title%"
      },
      {
        "command": "pi.openSessionDiff",
        "title": "%commands.pi.openSessionDiff.title%"
      },
      {
        "command": "pi.openExternalDir",
        "title": "%commands.pi.openExternalDir.title%"
      },
      {
        "command": "pi.revealInShadow",
        "title": "%commands.pi.revealInShadow.title%"
      },
      {
        "command": "pi.copyChangeContent",
        "title": "%commands.pi.copyChangeContent.title%"
      },
      {
        "command": "pi.copyDiffPatch",
        "title": "%commands.pi.copyDiffPatch.title%"
      },
      {
        "command": "pi.openFileHistoryDiff",
        "title": "%commands.pi.openFileHistoryDiff.title%",
        "icon": "$(git-compare)"
      },
      {
        "command": "pi.rescanWorkspace",
        "title": "%commands.pi.rescanWorkspace.title%"
      },
      {
        "command": "pi.exportSnapshotBundle",
        "title": "%commands.pi.exportSnapshotBundle.title%"
      },
      {
        "command": "pi.clearSessionShadowData",
        "title": "%commands.pi.clearSessionShadowData.title%"
      },
      {
        "command": "pi.showCostStats",
        "title": "%commands.pi.showCostStats.title%"
      },
      {
        "command": "pi.applyChangeDraft",
        "title": "%commands.pi.applyChangeDraft.title%"
      },
      {
        "command": "pi.rejectChangeDraft",
        "title": "%commands.pi.rejectChangeDraft.title%"
      },
      {
        "command": "pi.reviewChanges",
        "title": "%commands.pi.reviewChanges.title%"
      },
      {
        "command": "pi.generateCommitMessage",
        "title": "%commands.pi.generateCommitMessage.title%"
      },
      {
        "command": "pi.toggleReviewOnSave",
        "title": "%commands.pi.toggleReviewOnSave.title%"
      },
      {
        "command": "pi.bugReportWizard",
        "title": "%commands.pi.bugReportWizard.title%"
      },
      {
        "command": "pi.mcpList",
        "title": "%commands.pi.mcpList.title%"
      },
      {
        "command": "pi.showDiagnostics",
        "title": "%commands.pi.showDiagnostics.title%"
      },
      {
        "command": "pi.sendSelection",
        "title": "%commands.pi.sendSelection.title%"
      },
      {
        "command": "pi.sendFile",
        "title": "%commands.pi.sendFile.title%"
      },
      {
        "command": "pi.sendProblems",
        "title": "%commands.pi.sendProblems.title%"
      },
      {
        "command": "pi.sendGitDiff",
        "title": "%commands.pi.sendGitDiff.title%"
      },
      {
        "command": "pi.sendStagedDiff",
        "title": "%commands.pi.sendStagedDiff.title%"
      },
      {
        "command": "pi.compact",
        "title": "%commands.pi.compact.title%"
      },
      {
        "command": "pi.selectModel",
        "title": "%commands.pi.selectModel.title%"
      },
      {
        "command": "pi.selectThinkingLevel",
        "title": "%commands.pi.selectThinkingLevel.title%"
      },
      {
        "command": "pi.abort",
        "title": "%commands.pi.abort.title%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "pi.clearQueue",
        "title": "%commands.pi.clearQueue.title%"
      },
      {
        "command": "pi.showStatus",
        "title": "%commands.pi.showStatus.title%"
      },
      {
        "command": "pi.setSteeringMode",
        "title": "%commands.pi.setSteeringMode.title%"
      },
      {
        "command": "pi.setFollowUpMode",
        "title": "%commands.pi.setFollowUpMode.title%"
      },
      {
        "command": "pi.switchActiveSession",
        "title": "%commands.pi.switchActiveSession.title%",
        "icon": "$(list-selection)"
      },
      {
        "command": "pi.openTurnEditDiff",
        "title": "%commands.pi.openTurnEditDiff.title%",
        "icon": "$(diff)"
      },
      {
        "command": "pi.openSessionEditDiff",
        "title": "%commands.pi.openSessionEditDiff.title%",
        "icon": "$(git-compare)"
      },
      {
        "command": "pi.pickTurnDiff",
        "title": "%commands.pi.pickTurnDiff.title%",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "pi.checkEnvironment",
        "title": "%commands.pi.checkEnvironment.title%",
        "icon": "$(shield)"
      },
      {
        "command": "pi.restartPi",
        "title": "%commands.pi.restartPi.title%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "pi.openDocs",
        "title": "%commands.pi.openDocs.title%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pi.newSession",
          "when": "view == pi.chat",
          "group": "navigation@1"
        },
        {
          "command": "pi.newParallelSession",
          "when": "view == pi.chat",
          "group": "navigation@1"
        },
        {
          "command": "pi.openTui",
          "when": "view == pi.chat && config.pi.enableTui",
          "group": "navigation@2"
        },
        {
          "command": "pi.openChangesOverview",
          "when": "view == pi.chat",
          "group": "navigation@4"
        },
        {
          "command": "pi.pickTurnDiff",
          "when": "view == pi.chat",
          "group": "navigation@3"
        },
        {
          "command": "pi.abort",
          "when": "view == pi.chat && pi.isStreaming",
          "group": "navigation@5"
        },
        {
          "command": "pi.newSession",
          "when": "view == pi.chatSecondary",
          "group": "navigation@1"
        },
        {
          "command": "pi.newParallelSession",
          "when": "view == pi.chatSecondary",
          "group": "navigation@1"
        },
        {
          "command": "pi.pickTurnDiff",
          "when": "view == pi.chatSecondary",
          "group": "navigation@2"
        },
        {
          "command": "pi.openChangesOverview",
          "when": "view == pi.chatSecondary",
          "group": "navigation@3"
        },
        {
          "command": "pi.abort",
          "when": "view == pi.chatSecondary && pi.isStreaming",
          "group": "navigation@4"
        },
        {
          "command": "pi.openChangesOverview",
          "when": "view == pi.changes",
          "group": "navigation@1"
        },
        {
          "command": "pi.rescanWorkspace",
          "when": "view == pi.changes",
          "group": "navigation@2"
        },
        {
          "command": "pi.resumeSession",
          "when": "view == pi.sessions",
          "group": "navigation@1"
        },
        {
          "command": "pi.resumeSession",
          "when": "view == pi.chat",
          "group": "navigation@0"
        },
        {
          "command": "pi.resumeSession",
          "when": "view == pi.chatSecondary",
          "group": "navigation@0"
        },
        {
          "command": "pi.mcpList",
          "when": "view == pi.agents",
          "group": "navigation@1"
        },
        {
          "command": "pi.pickTurnDiff",
          "when": "view == pi.changes",
          "group": "navigation@0"
        },
        {
          "command": "pi.checkEnvironment",
          "when": "view == pi.changes",
          "group": "navigation@9"
        },
        {
          "command": "pi.restartPi",
          "when": "view == pi.chat",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "pi.openChangeDiff",
          "when": "view == pi.changes && viewItem == pi.change",
          "group": "inline@1"
        },
        {
          "command": "pi.copyChangeContent",
          "when": "view == pi.changes && viewItem == pi.change",
          "group": "inline@2"
        },
        {
          "command": "pi.copyDiffPatch",
          "when": "view == pi.changes && viewItem == pi.change"
        },
        {
          "command": "pi.applyChangeDraft",
          "when": "view == pi.changes && viewItem == pi.change"
        },
        {
          "command": "pi.rejectChangeDraft",
          "when": "view == pi.changes && viewItem == pi.change"
        },
        {
          "command": "pi.openExternalDir",
          "when": "view == pi.changes && viewItem == pi.externalGroup"
        },
        {
          "command": "pi.openTurnDiff",
          "when": "view == pi.changes && viewItem == pi.turn"
        },
        {
          "command": "pi.revealInShadow",
          "when": "view == pi.changes && viewItem == pi.turn"
        },
        {
          "command": "pi.switchSession",
          "when": "view == pi.sessions && viewItem == pi.session"
        },
        {
          "command": "pi.renameSession",
          "when": "view == pi.sessions && viewItem == pi.session"
        },
        {
          "command": "pi.openSessionInNewTab",
          "when": "view == pi.sessions && viewItem == pi.session"
        }
      ],
      "editor/context": [
        {
          "command": "pi.sendSelection",
          "when": "editorHasSelection",
          "group": "pi@1"
        },
        {
          "command": "pi.sendFile",
          "group": "pi@2"
        },
        {
          "command": "pi.openFileHistoryDiff",
          "group": "pi@3"
        }
      ],
      "explorer/context": [
        {
          "command": "pi.sendFile",
          "group": "pi@1"
        },
        {
          "command": "pi.openFileHistoryDiff",
          "group": "pi@2"
        }
      ],
      "editor/title": [
        {
          "command": "pi.openFileHistoryDiff",
          "when": "pi.hasChangeForActiveFile",
          "group": "navigation"
        }
      ],
      "scm/title": [
        {
          "command": "pi.generateCommitMessage",
          "group": "navigation"
        },
        {
          "command": "pi.pickTurnDiff",
          "group": "navigation",
          "when": "pi.hasChanges"
        }
      ],
      "commandPalette": [
        {
          "command": "pi.openTui",
          "when": "config.pi.enableTui"
        },
        {
          "command": "pi.openTurnDiff"
        },
        {
          "command": "pi.openSessionDiff"
        },
        {
          "command": "pi.openExternalDir"
        },
        {
          "command": "pi.reviewChanges"
        },
        {
          "command": "pi.mcpList"
        },
        {
          "command": "pi.bugReportWizard"
        },
        {
          "command": "pi.sharePreview"
        },
        {
          "command": "pi.showCostStats"
        },
        {
          "command": "pi.switchActiveSession"
        },
        {
          "command": "pi.openDocs"
        }
      ]
    },
    "configuration": {
      "title": "Pi",
      "properties": {
        "pi.executablePath": {
          "type": "string",
          "default": "",
          "description": "%config.pi.executablePath.description%"
        },
        "pi.cliEntryPath": {
          "type": "string",
          "default": "",
          "description": "%config.pi.cliEntryPath.description%"
        },
        "pi.nodePath": {
          "type": "string",
          "default": "",
          "description": "%config.pi.nodePath.description%"
        },
        "pi.model": {
          "type": "string",
          "default": "",
          "description": "%config.pi.model.description%"
        },
        "pi.thinkingLevel": {
          "type": "string",
          "enum": [
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "medium"
        },
        "pi.enableTui": {
          "type": "boolean",
          "default": true,
          "description": "%config.pi.enableTui.description%"
        },
        "pi.multiSession": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.pi.multiSession.markdownDescription%",
          "deprecationMessage": "%config.pi.multiSession.deprecationMessage%"
        },
        "pi.reviewOnSave.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.pi.reviewOnSave.enabled.description%"
        },
        "pi.reviewOnSave.debounceMs": {
          "type": "number",
          "default": 3000
        },
        "pi.reviewOnSave.prompt": {
          "type": "string",
          "default": "请审查以下文件保存后的改动，指出潜在问题（只回答，不修改文件）：\n${files}"
        },
        "pi.shadowGit.enabled": {
          "type": "boolean",
          "default": true
        },
        "pi.shadowGit.location": {
          "type": "string",
          "enum": [
            "globalStorage",
            "workspaceStorage",
            "custom"
          ],
          "default": "globalStorage"
        },
        "pi.shadowGit.customPath": {
          "type": "string",
          "default": ""
        },
        "pi.shadowGit.scope": {
          "type": "string",
          "enum": [
            "workspace",
            "workspaceAndExternal"
          ],
          "default": "workspaceAndExternal"
        },
        "pi.shadowGit.externalPolicy": {
          "type": "string",
          "enum": [
            "explicitWrites",
            "allowlistOnly",
            "all"
          ],
          "default": "explicitWrites",
          "description": "%config.pi.shadowGit.externalPolicy.description%"
        },
        "pi.shadowGit.externalAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.pi.shadowGit.externalAllowlist.description%"
        },
        "pi.shadowGit.maxFileBytes": {
          "type": "number",
          "default": 2097152
        },
        "pi.shadowGit.maxTotalBytes": {
          "type": "number",
          "default": 67108864
        },
        "pi.shadowGit.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/build/**",
            "**/*.log",
            "**/.pi/agent/sessions/**"
          ]
        },
        "pi.shadowGit.redactSecrets": {
          "type": "boolean",
          "default": true,
          "description": "%config.pi.shadowGit.redactSecrets.description%"
        },
        "pi.shadowGit.snapshotMode": {
          "type": "string",
          "enum": [
            "settled"
          ],
          "default": "settled",
          "markdownDescription": "%config.pi.shadowGit.snapshotMode.markdownDescription%"
        },
        "pi.shadowGit.baseMode": {
          "type": "string",
          "enum": [
            "auto",
            "full",
            "candidatesOnly"
          ],
          "default": "auto",
          "description": "%config.pi.shadowGit.baseMode.description%"
        },
        "pi.shadowGit.usePiExtension": {
          "type": "boolean",
          "default": true,
          "description": "%config.pi.shadowGit.usePiExtension.description%"
        },
        "pi.shadowGit.retentionDays": {
          "type": "number",
          "default": 90
        },
        "pi.shadowGit.autoGc": {
          "type": "boolean",
          "default": true
        },
        "pi.showDiagnosticsOnError": {
          "type": "boolean",
          "default": true,
          "description": "%config.pi.showDiagnosticsOnError.description%"
        }
      }
    },
    "keybindings": [
      {
        "command": "pi.chat.focus",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "pi.chat.focusSecondary",
        "key": "ctrl+alt+shift+p",
        "mac": "cmd+alt+shift+p"
      },
      {
        "command": "pi.sendSelection",
        "key": "ctrl+alt+enter",
        "when": "editorHasSelection"
      },
      {
        "command": "pi.abort",
        "key": "ctrl+alt+x",
        "when": "pi.isStreaming"
      },
      {
        "command": "pi.openChangesOverview",
        "key": "ctrl+alt+d"
      },
      {
        "command": "pi.openTurnEditDiff",
        "key": "ctrl+alt+shift+d",
        "mac": "cmd+alt+shift+d"
      },
      {
        "command": "pi.newParallelSession",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      },
      {
        "command": "pi.switchActiveSession",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "chatParticipants": [
      {
        "id": "pi-vscode.pi",
        "name": "pi",
        "fullName": "Pi",
        "description": "%chatParticipants.pi-vscode.pi.description%",
        "isSticky": true,
        "commands": [
          {
            "name": "model",
            "description": "%chatParticipants.pi-vscode.pi.commands.model.description%"
          },
          {
            "name": "diff",
            "description": "%chatParticipants.pi-vscode.pi.commands.diff.description%"
          },
          {
            "name": "new",
            "description": "%chatParticipants.pi-vscode.pi.commands.new.description%"
          },
          {
            "name": "compact",
            "description": "%chatParticipants.pi-vscode.pi.commands.compact.description%"
          }
        ]
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "~1.95.0",
    "esbuild": "^0.24.0",
    "marked": "^15.0.12",
    "typescript": "^5.7.0"
  }
}
